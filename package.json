{
	"name": "raft-movies",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"precheck": "npm run format && npm run lint:fix",
		"format:css": "npm run format && npm run lint:css",
		"db:build": "docker build -t my-postgres .",
		"db:up": "docker run --env-file .env -p 5433:5432 --name my-postgres -d my-postgres",
		"db:down": "docker stop my-postgres && docker rm my-postgres",
		"db:start": "npm run db:build && npm run db:up",
		"db:migrate": "npx prisma migrate deploy",
		"db:start-and-migrate": "npm run db:start && npm run db:migrate"
	},
	"devDependencies": {
		"@eslint/compat": "1.3.1",
		"@eslint/js": "9.18.0",
		"@fontsource-variable/montserrat": "5.2.6",
		"@node-rs/argon2": "2.0.2",
		"@sveltejs/adapter-auto": "6.0.1",
		"@sveltejs/kit": "2.22.0",
		"@sveltejs/vite-plugin-svelte": "5.1.0",
		"@types/flexsearch": "0.7.6",
		"@types/node": "25.0.9",
		"eslint": "9.29.0",
		"eslint-config-prettier": "10.1.5",
		"eslint-plugin-prettier": "5.5.1",
		"eslint-plugin-svelte": "3.18.0",
		"globals": "16.2.0",
		"prettier": "3.6.1",
		"prettier-plugin-css-order": "2.1.2",
		"prettier-plugin-svelte": "3.4.0",
		"prisma": "6.17.1",
		"svelte": "5.34.8",
		"svelte-check": "4.2.2",
		"sveltekit-superforms": "2.27.1",
		"typescript": "5.8.3",
		"typescript-eslint": "8.35.0",
		"vite": "6.3.5",
		"zod": "3.25.76"
	},
	"dependencies": {
		"@prisma/client": "6.17.1",
		"@supabase/supabase-js": "2.106.2",
		"flexsearch": "0.8.212",
		"svelte-sonner": "1.1.1"
	}
}
